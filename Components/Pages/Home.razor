@page "/"
<PageTitle>首页</PageTitle>

<div class="home-hero px-4 py-5">
    <div class="home-shell mx-auto">
        <section class="hero-card mb-4">
            <div class="hero-glow hero-glow-1"></div>
            <div class="hero-glow hero-glow-2"></div>

            <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-4 position-relative">
                <div class="hero-copy">
                    <div class="eyebrow mb-3">Uptime123 · 站点监控与后台管理</div>
                    <h1 class="display-6 fw-bold mb-3 hero-title">把站点监控、后台管理和告警能力，收拢到一个轻量而完整的系统里。</h1>
                    <p class="lead mb-4 hero-subtitle">
                        这是一个基于 <strong>NovaAdmin.Blazor</strong> 构建的 .NET 8 项目，核心目标是快速管理监控站点、自动轮询健康状态、记录告警信息，并且预留 Telegram 通知能力，方便后续扩展为完整的运维面板。
                    </p>

                    <div class="d-flex flex-wrap gap-2">
                        <span class="pill">后台管理</span>
                        <span class="pill">站点轮询</span>
                        <span class="pill">SSL / Ping / HTTP 检测</span>
                        <span class="pill">Telegram 告警</span>
                        <span class="pill">SQLite + FreeSql</span>
                    </div>
                </div>

                <div class="hero-side card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="text-uppercase small text-muted mb-2">项目状态</div>
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            <div class="status-dot"></div>
                            <div class="h4 mb-0 fw-semibold">Ready for monitoring</div>
                        </div>
                        <div class="small text-muted lh-lg">
                            已具备页面管理、菜单种子、轮询服务、告警通知与后台组件演示页面。
                            后续可以继续增加分组、报表、事件日志和移动端通知能力。
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="row g-3 mb-4">
            <div class="col-12 col-lg-4">
                <div class="info-card h-100">
                    <div class="info-icon">01</div>
                    <h2 class="h5 mb-2">项目简介</h2>
                    <p class="mb-0 text-muted">
                        用一个后台统一管理监控站点配置、检查策略和状态结果，减少散落在脚本和配置文件里的维护成本。
                    </p>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="info-card h-100">
                    <div class="info-icon">02</div>
                    <h2 class="h5 mb-2">核心功能</h2>
                    <p class="mb-0 text-muted">
                        支持站点的启停管理、检查间隔、失败阈值、关键字匹配、最近状态展示，以及自动轮询与异常告警。
                    </p>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="info-card h-100">
                    <div class="info-icon">03</div>
                    <h2 class="h5 mb-2">技术栈</h2>
                    <p class="mb-0 text-muted">
                        ASP.NET Core + Blazor Server、NovaAdmin.Blazor、FreeSql、SQLite、后台 HostedService、Telegram Bot API。
                    </p>
                </div>
            </div>
        </section>

        <section class="row g-3">
            <div class="col-12 col-xl-7">
                <div class="panel-card h-100">
                    <div class="panel-header mb-3">
                        <h2 class="h5 mb-1">运行机制</h2>
                        <p class="text-muted mb-0">项目的后台流程与页面内容是分离的，方便持续扩展。</p>
                    </div>

                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-badge">A</div>
                            <div>
                                <div class="fw-semibold">站点配置</div>
                                <div class="text-muted small">在“监控站点”页面维护名称、地址、检查周期和失败阈值。</div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-badge">B</div>
                            <div>
                                <div class="fw-semibold">轮询检测</div>
                                <div class="text-muted small">后台服务定时执行 Ping、HTTP 与 SSL 检测，并写回状态字段。</div>
                            </div>
                        </div>
                        <div class="timeline-item">
                            <div class="timeline-badge">C</div>
                            <div>
                                <div class="fw-semibold">异常告警</div>
                                <div class="text-muted small">连续失败达到阈值后，通过 Telegram 发送站点告警信息。</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="panel-card h-100">
                    <div class="panel-header mb-3">
                        <h2 class="h5 mb-1">Telegram 配置信息</h2>
                        <p class="text-muted mb-0">配置项保存在开发环境配置文件中。</p>
                    </div>

                    <div class="config-box mb-3">
                        <div class="small text-muted mb-1">配置文件</div>
                        <div class="fw-semibold">appsettings.Development.json</div>
                    </div>

                    <div class="config-grid">
                        <div class="config-item">
                            <div class="small text-muted">Telegram:BotToken</div>
                            <code class="d-block">请在本地配置你的 Bot Token</code>
                        </div>
                        <div class="config-item">
                            <div class="small text-muted">Telegram:ChatId</div>
                            <code class="d-block">请填入目标聊天 ID</code>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-3 mb-0 small">
                        Telegram 凭据属于敏感信息，建议仅保存在本地开发配置或安全的密钥管理方案中，不要写入公开页面或代码仓库。
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>
    .home-hero {
        min-height: calc(100vh - 2rem);
        background:
            radial-gradient(circle at top left, rgba(16, 185, 129, 0.14), transparent 28%),
            radial-gradient(circle at top right, rgba(59, 130, 246, 0.12), transparent 24%),
            linear-gradient(180deg, #f8fbfc 0%, #eef4f7 100%);
        color: #162233;
    }

    .home-shell {
        max-width: 1180px;
    }

    .hero-card,
    .panel-card,
    .info-card,
    .hero-side {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(148, 163, 184, 0.18);
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
    }

    .hero-card {
        padding: 2rem;
    }

    .hero-copy {
        max-width: 760px;
        position: relative;
        z-index: 1;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.06);
        color: #334155;
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .hero-title {
        line-height: 1.05;
        letter-spacing: -0.04em;
        color: #0f172a;
        max-width: 12ch;
    }

    .hero-subtitle {
        max-width: 68ch;
        color: #475569;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        padding: 0.55rem 0.9rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(148, 163, 184, 0.22);
        color: #1f2937;
        font-size: 0.92rem;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05);
    }

    .hero-side {
        min-width: min(100%, 320px);
        max-width: 360px;
    }

    .status-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 6px rgba(16, 185, 129, 0.14);
    }

    .info-card,
    .panel-card {
        padding: 1.4rem;
    }

    .info-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        margin-bottom: 1rem;
        border-radius: 1rem;
        background: linear-gradient(135deg, #0f172a, #334155);
        color: #fff;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .timeline {
        display: grid;
        gap: 1rem;
    }

    .timeline-item {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.9rem;
        align-items: start;
        padding: 1rem;
        border-radius: 18px;
        background: rgba(248, 250, 252, 0.9);
        border: 1px solid rgba(148, 163, 184, 0.16);
    }

    .timeline-badge {
        width: 2.3rem;
        height: 2.3rem;
        border-radius: 0.8rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: #fff;
        font-weight: 700;
    }

    .config-box,
    .config-item {
        border-radius: 16px;
        border: 1px solid rgba(148, 163, 184, 0.18);
        background: rgba(248, 250, 252, 0.92);
        padding: 1rem;
    }

    .config-grid {
        display: grid;
        gap: 0.75rem;
    }

    .hero-glow {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(18px);
        opacity: 0.7;
    }

    .hero-glow-1 {
        width: 180px;
        height: 180px;
        right: -40px;
        top: -40px;
        background: rgba(59, 130, 246, 0.18);
    }

    .hero-glow-2 {
        width: 220px;
        height: 220px;
        left: -60px;
        bottom: -80px;
        background: rgba(16, 185, 129, 0.16);
    }

    @@media (max-width: 991.98px) {
        .hero-card {
            padding: 1.4rem;
        }

        .hero-title {
            max-width: none;
        }
    }
</style>
